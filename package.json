{
	"name": "n8n-nodes-postel",
	"version": "0.1.0",
	"description": "n8n community node for Postel: find viral posts in your niche on X, YouTube, TikTok and Instagram, write your take in your voice with AI, and auto-post to LinkedIn, X, Bluesky and Mastodon.",
	"license": "MIT",
	"homepage": "https://www.postel.app",
	"bugs": {
		"url": "https://github.com/robinfaraj/n8n-nodes-postel/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-node",
		"postel",
		"social media automation",
		"automate social media posts",
		"automate linkedin posts",
		"auto post to linkedin",
		"linkedin auto post",
		"twitter automation",
		"linkedin",
		"x",
		"twitter",
		"bluesky",
		"mastodon",
		"viral posts",
		"viral content",
		"content ideas",
		"ai social media posts",
		"social media scheduler"
	],
	"author": {
		"name": "Postel",
		"email": "contact@postel.app"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/robinfaraj/n8n-nodes-postel.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PostelApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Postel/Postel.node.js",
			"dist/nodes/PostelTrigger/PostelTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.6",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
